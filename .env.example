# Cadena de conexión de MongoDB Atlas (la misma base que usa el agente de voz).
# Formato: mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Clave para firmar las cookies de sesión (tanto de usuarios normales como de
# /superadmin). Cualquier cadena larga y aleatoria — ej. `openssl rand -hex 48`.
SESSION_SECRET=

# Contraseña única para entrar a /superadmin (crear organizaciones y ajustar
# cupos de licencias). No hay usuario, es una sola contraseña compartida —
# cámbiala por una propia, no uses la de ejemplo.
SUPERADMIN_PASSWORD=
